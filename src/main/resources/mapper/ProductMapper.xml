<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.study.dao.ProductMapper">

    <resultMap id="productResultMap" type="ProductEntity">
        <id     property="productId" column="product_id"/>
        <result property="name"      column="name"/>
        <result property="price"     column="price"/>
        <result property="stock"     column="stock"/>
    </resultMap>

    <select id="findById" parameterType="int" resultMap="productResultMap">
        SELECT product_id, name, price, stock FROM products WHERE product_id = #{productId}
    </select>

    <update id="decrementStock">
        UPDATE products SET stock = stock - #{quantity} WHERE product_id = #{productId}
    </update>

</mapper>
