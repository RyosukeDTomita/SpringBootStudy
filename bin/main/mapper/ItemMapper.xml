<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.study.dao.ItemMapper">

    <resultMap id="itemResultMap" type="ItemEntity">
        <id     property="itemId"      column="item_id"/>
        <result property="name"        column="name"/>
        <result property="price"       column="price"/>
        <result property="description" column="description"/>
    </resultMap>

    <select id="findAll" resultMap="itemResultMap">
        SELECT item_id, name, price, description FROM items ORDER BY item_id
    </select>

    <select id="findById" parameterType="int" resultMap="itemResultMap">
        SELECT item_id, name, price, description FROM items WHERE item_id = #{itemId}
    </select>

    <insert id="insert" parameterType="ItemEntity" useGeneratedKeys="true" keyProperty="itemId">
        INSERT INTO items (name, price, description) VALUES (#{name}, #{price}, #{description})
    </insert>

    <update id="update" parameterType="ItemEntity">
        UPDATE items SET name = #{name}, price = #{price}, description = #{description} WHERE item_id = #{itemId}
    </update>

    <delete id="deleteById" parameterType="int">
        DELETE FROM items WHERE item_id = #{itemId}
    </delete>

</mapper>
